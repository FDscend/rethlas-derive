# 复制为 .env 后填写；.env 已被 gitignore，不会提交。
# 用法：把本文件复制为 .env（放工具根目录或当前工作目录均可，工具会搜索）。

# ---- MinerU 完整模式 + VLM 的 API Token ----
# 获取：https://mineru.net/apiManage/token
# 优先级：mineru-open-api auth（npm CLI）> MINERU_TOKEN（本文件）> 离线 PyMuPDF 降级
MINERU_TOKEN=

# ---- Tavily 网络搜索 API Key（可选）----
# 获取：https://app.tavily.com
# 推导循环内的网络搜索：有 key 用 Tavily REST；无 key 自动降级到 codex 内置 web search
TAVILY_API_KEY=

# ---- 可选：指定 config.yaml 路径 ----
# 默认自动查找工具根目录的 config.yaml；需要时取消注释并填写
# DERIVE_CONFIG=
